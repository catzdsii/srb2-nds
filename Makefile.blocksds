# Makefile for SRB2 DSi using BlocksDS

# -------------------------------------------------------------------------
# BlocksDS Environment
# -------------------------------------------------------------------------
ifeq ($(strip $(BLOCKSDS)),)
$(error "Please set BLOCKSDS in your environment. export BLOCKSDS=/opt/blocksds/core")
endif

BLOCKSDSEXT ?= /opt/blocksds/external

# -------------------------------------------------------------------------
# Project Settings
# -------------------------------------------------------------------------
NAME		:= srb2_dsi
GAME_TITLE	:= SRB2 DSi
GAME_SUBTITLE	:= Sonic Robo Blast 2

# Source directories (space separated)
SOURCES		:= source source/dsi source/hardware source/blua

# Include directories
INCLUDES	:= source

# Data directories (for filesystem)
DATA		:= 

# Graphics directories (converted with grit)
GRAPHICS	:= gfx

# Build directory
BUILD		:= build_blocksds

# -------------------------------------------------------------------------
# Compiler Options
# -------------------------------------------------------------------------
ARCH		:= -march=armv5te -mtune=arm946e-s

DEFINES		:= -D__NDS__ -D_NDS -DARM9 -DNONET -DNO_IPV6 -DNOHS -DNOMD5 \
			   -DHAVE_BLUA -DNOPOSTPROCESSING -DNOSPLITSCREEN \
			   -DDSI_MODE -DRAYCAST_RENDER -DMAX_POLYGONS=2000

CFLAGS		:= -g -Wall -O2 -mthumb \
			   -fomit-frame-pointer -ffast-math \
			   -Wno-error -Wno-format -Wno-sizeof-pointer-memaccess \
			   -Wno-incompatible-pointer-types \
			   $(ARCH) $(DEFINES)

CXXFLAGS	:= $(CFLAGS) -fno-rtti -fno-exceptions

ASFLAGS		:= -g $(ARCH)

# -------------------------------------------------------------------------
# Libraries
# -------------------------------------------------------------------------
LIBS		:= -lNE -lmm9 -lnds9 -lm -lfat

LIBDIRS		:= $(BLOCKSDSEXT)/lib
# Add external include URL for libs if needed
# INCLUDEDIRS := $(BLOCKSDSEXT)/include

# -------------------------------------------------------------------------
# BlocksDS Rules
# -------------------------------------------------------------------------
# Check for valid template path, fall back to probable locations if needed
ifneq ("$(wildcard $(BLOCKSDS)/sys/default_makefiles/rom_arm9/Makefile)","")
include $(BLOCKSDS)/sys/default_makefiles/rom_arm9/Makefile
else
$(error "Could not find BlocksDS makefile template at $(BLOCKSDS)/sys/default_makefiles/rom_arm9/Makefile")
endif
